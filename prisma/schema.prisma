  workCase    WorkCase                @relation(fields: [workCaseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      WorkTaskStatus          @default(TODO)
  priority    WorkCasePriority        @default(NORMAL)
  startAt     DateTime?
  dueAt       DateTime?
  assignments WorkTaskAssignment[]
  comments    WorkTaskComment[]
  checklist   WorkTaskChecklistItem[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([workCaseId, status])
  @@index([status, dueAt])
}

model WorkTaskAssignment {
  id         String   @id @default(cuid())
  workTaskId String
  workTask   WorkTask @relation(fields: [workTaskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       String   @default("ASSIGNEE")
  createdAt  DateTime @default(now())

  @@unique([workTaskId, userId])
  @@index([userId])
}

model WorkTaskComment {
  id         String   @id @default(cuid())
  workTaskId String
  workTask   WorkTask @relation(fields: [workTaskId], references: [id], onDelete: Cascade)
  content    String
  actorType  String
  actorId    String
  actorName  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([workTaskId, createdAt])
}

model WorkTaskChecklistItem {
  id              String    @id @default(cuid())
  workTaskId      String
  workTask        WorkTask  @relation(fields: [workTaskId], references: [id], onDelete: Cascade)
  title           String
  completed       Boolean   @default(false)
  completedAt     DateTime?
  completedByType String?
  completedById   String?
  completedByName String?
  position        Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workTaskId, position])
}

model Post {
  id           String                   @id @default(cuid())
  title        String
  body         String
  status       PostStatus               @default(DRAFT)
  audienceType PostAudienceType         @default(ALL)
  authorType   String
  authorId     String
  authorName   String
  publishedAt  DateTime?
  pinnedAt     DateTime?
  audiences    PostAudienceDepartment[]
  comments     PostComment[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([status, pinnedAt, publishedAt])
  @@index([authorId, status])
}

model PostAudienceDepartment {
  id           String     @id @default(cuid())
  postId       String
  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([postId, departmentId])
  @@index([departmentId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  content   String
  actorType String
  actorId   String
  actorName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  href      String?
  actorType String?
  actorId   String?
  actorName String?
  readAt    DateTime?
  dedupeKey String?   @unique
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model WorkCaseContact {
  id         String   @id @default(cuid())
  workCaseId String
  workCase   WorkCase @relation(fields: [workCaseId], references: [id], onDelete: Cascade)
  name       String
  role       String?
  phone      String?
  email      String?
  createdAt  DateTime @default(now())

  @@index([workCaseId])
}

model WorkCaseTraveler {
  id         String   @id @default(cuid())
  workCaseId String
  workCase   WorkCase @relation(fields: [workCaseId], references: [id], onDelete: Cascade)
  fullName   String
  notes      String?
  createdAt  DateTime @default(now())

  @@index([workCaseId])
}

model FolderPermission {
  id              String  @id @default(cuid())
  userId          String
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId        String
  folderPath      String
  canUpload       Boolean @default(false)
  canList         Boolean @default(false)
  canRead         Boolean @default(false)
  canDelete       Boolean @default(false)
  canCreateFolder Boolean @default(false)

  @@unique([userId, folderId])
  @@index([userId])
}
