generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum DepartmentRole {
  MANAGER
  MEMBER
}

enum PartyType {
  PERSON
  ORGANIZATION
}

enum WorkCaseStatus {
  RECEIVED
  CONSULTING
  CONFIRMED
  BOOKING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum WorkCasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum BookingStatus {
  REQUESTED
  ON_HOLD
  CONFIRMED
  CANCELLED
}

enum WorkTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PostAudienceType {
  ALL
  DEPARTMENTS
}

enum CustomerLifecycle {
  LEAD
  PROSPECT
  CUSTOMER
  INACTIVE
}

enum CustomerInteractionType {
  CALL
  EMAIL
  MEETING
  MESSAGE
  NOTE
}

enum CustomerMergeStatus {
  PENDING
  MERGED
  REJECTED
}

enum DocumentTemplateType {
  HEADER
  FOOTER
  CONTENT
}

model User {
  id                       String                 @id @default(cuid())
  fullName                 String
  username                 String                 @unique
  email                    String?
  phoneNumber              String?
  citizenId                String?
  department               String?
  passwordHash             String
  role                     Role                   @default(USER)
  systemRoleId             String
  systemRole               SystemRole             @relation(fields: [systemRoleId], references: [id], onDelete: Restrict)
  active                   Boolean                @default(true)
  permissions              FolderPermission[]
  memberships              DepartmentMembership[]
  receivedCases            WorkCase[]             @relation("WorkCaseReceiver")
  taskAssignments          WorkTaskAssignment[]
  notifications            Notification[]
  ownedCustomers           Customer[]             @relation("CustomerOwner")
  reviewedCustomerMerges   CustomerMergeReview[]  @relation("CustomerMergeReviewer")
  assignedLeads            Lead[]                 @relation("LeadAssignee")
  assignedB2BLeads         B2BLead[]              @relation("B2BLeadAssignee")
  signedTourGuideContracts TourGuideContract[]    @relation("TourGuideContractSigner")
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([systemRoleId])
}

model SystemRole {
  id                   String                    @id @default(cuid())
  code                 String                    @unique
  name                 String                    @unique
  description          String?
  isSystemAdmin        Boolean                   @default(false)
  active               Boolean                   @default(true)
  users                User[]
  leadFieldPermissions LeadFieldRolePermission[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([active, name])
}

model Department {
  id            String                   @id @default(cuid())
  name          String                   @unique
  code          String                   @unique
  description   String?
  active        Boolean                  @default(true)
  memberships   DepartmentMembership[]
  parentId      String?
  parent        Department?              @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Department[]             @relation("DepartmentTree")
  workCases     WorkCase[]
  postAudiences PostAudienceDepartment[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([parentId])
}

model DepartmentMembership {
  id                       String                                   @id @default(cuid())
  userId                   String
  user                     User                                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId             String
  department               Department                               @relation(fields: [departmentId], references: [id])
  role                     DepartmentRole                           @default(MEMBER)
  isPrimary                Boolean                                  @default(false)
  canManageMembers         Boolean                                  @default(false)
  canManageWorkCases       Boolean                                  @default(false)
  canAssignTasks           Boolean                                  @default(false)
  canManageBookings        Boolean                                  @default(false)
  canViewReports           Boolean                                  @default(false)
  canViewCustomers         Boolean                                  @default(false)
  canManageCustomers       Boolean                                  @default(false)
  permissionGrants         DepartmentMembershipPermission[]
  resourcePermissionGrants DepartmentMembershipResourcePermission[]
  createdAt                DateTime                                 @default(now())

  @@unique([userId, departmentId])
  @@index([departmentId])
}

model DepartmentPermissionDefinition {
  id          String                           @id @default(cuid())
  code        String                           @unique
  name        String                           @unique
  description String?
  active      Boolean                          @default(true)
  grants      DepartmentMembershipPermission[]
  createdAt   DateTime                         @default(now())
  updatedAt   DateTime                         @updatedAt

  @@index([active, name])
}

model DepartmentMembershipPermission {
  membershipId String
  membership   DepartmentMembership           @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permissionId String
  permission   DepartmentPermissionDefinition @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime                       @default(now())

  @@id([membershipId, permissionId])
  @@index([permissionId])
}

model AccessResource {
  id                  String               @id @default(cuid())
  code                String               @unique
  name                String               @unique
  description         String?
  active              Boolean              @default(true)
  resourcePermissions ResourcePermission[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([active, name])
}

model BasePermission {
  id                  String               @id @default(cuid())
  code                String               @unique
  name                String               @unique
  description         String?
  active              Boolean              @default(true)
  resourcePermissions ResourcePermission[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([active, name])
}

model ResourcePermission {
  id               String                                   @id @default(cuid())
  name             String                                   @unique
  resourceId       String
  resource         AccessResource                           @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  basePermissionId String
  basePermission   BasePermission                           @relation(fields: [basePermissionId], references: [id], onDelete: Restrict)
  description      String?
  active           Boolean                                  @default(true)
  createdAt        DateTime                                 @default(now())
  updatedAt        DateTime                                 @updatedAt
  grants           DepartmentMembershipResourcePermission[]

  @@unique([resourceId, basePermissionId])
  @@index([active])
  @@index([basePermissionId])
}

model DepartmentMembershipResourcePermission {
  membershipId         String
  membership           DepartmentMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  resourcePermissionId String
  resourcePermission   ResourcePermission   @relation(fields: [resourcePermissionId], references: [id], onDelete: Cascade)
  createdAt            DateTime             @default(now())

  @@id([membershipId, resourcePermissionId])
  @@index([resourcePermissionId])
}

model Customer {
  id                String                      @id @default(cuid())
  code              String                      @unique
  name              String
  partyType         PartyType
  phone             String?
  whatsapp          String?
  email             String?
  country           String?
  taxId             String?
  notes             String?
  metadata          Json                        @default("{}")
  lifecycle         CustomerLifecycle           @default(LEAD)
  source            String?
  ownerId           String?
  owner             User?                       @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lastContactAt     DateTime?
  dateReceived      DateTime?
  nextFollowUpAt    DateTime?
  active            Boolean                     @default(true)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  workCases         WorkCase[]
  contacts          CustomerContact[]
  interactions      CustomerInteraction[]
  assignmentHistory CustomerAssignmentHistory[]
  mergeSources      CustomerMergeReview[]       @relation("CustomerMergeSource")
  mergeTargets      CustomerMergeReview[]       @relation("CustomerMergeTarget")
  segmentId         String?
  segment           CustomerSegment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  tags              CustomerTagAssignment[]

  @@index([name])
  @@index([phone])
  @@index([whatsapp])
  @@index([email])
  @@index([lifecycle, ownerId])
  @@index([nextFollowUpAt])
  @@index([segmentId])
}

model CustomerSegment {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  active      Boolean    @default(true)
  customers   Customer[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model CustomerTag {
  id          String                  @id @default(cuid())
  name        String                  @unique
  color       String?
  active      Boolean                 @default(true)
  assignments CustomerTagAssignment[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model CustomerTagAssignment {
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@id([customerId, tagId])
  @@index([tagId])
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  role       String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  notes      String?
  metadata   Json     @default("{}")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, isPrimary])
}

model CustomerInteraction {
  id             String                        @id @default(cuid())
  customerId     String
  customer       Customer                      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workCaseId     String?
  workCase       WorkCase?                     @relation(fields: [workCaseId], references: [id], onDelete: SetNull)
  type           CustomerInteractionType
  happenedAt     DateTime
  summary        String
  outcome        String?
  nextFollowUpAt DateTime?
  metadata       Json                          @default("{}")
  actorType      String
  actorId        String
  actorName      String
  revisions      CustomerInteractionRevision[]
  createdAt      DateTime                      @default(now())

  @@index([customerId, happenedAt])
  @@index([workCaseId])
  @@index([nextFollowUpAt])
}

model CustomerInteractionRevision {
  id            String              @id @default(cuid())
  interactionId String
  interaction   CustomerInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  previousData  Json
  actorType     String
  actorId       String
  actorName     String
  createdAt     DateTime            @default(now())

  @@index([interactionId, createdAt])
}

model CustomerAssignmentHistory {
  id                String   @id @default(cuid())
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  previousOwnerId   String?
  previousOwnerName String?
  newOwnerId        String?
  newOwnerName      String?
  reason            String?
  actorType         String
  actorId           String
  actorName         String
  createdAt         DateTime @default(now())

  @@index([customerId, createdAt])
}

model CustomerMergeReview {
  id               String              @id @default(cuid())
  sourceCustomerId String
  sourceCustomer   Customer            @relation("CustomerMergeSource", fields: [sourceCustomerId], references: [id], onDelete: Restrict)
  targetCustomerId String
  targetCustomer   Customer            @relation("CustomerMergeTarget", fields: [targetCustomerId], references: [id], onDelete: Restrict)
  matchedFields    Json
  status           CustomerMergeStatus @default(PENDING)
  requestedByType  String
  requestedById    String
  requestedByName  String
  reviewedById     String?
  reviewedBy       User?               @relation("CustomerMergeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedByName   String?
  reviewNote       String?
  reviewedAt       DateTime?
  createdAt        DateTime            @default(now())

  @@index([sourceCustomerId, targetCustomerId])
  @@index([status, createdAt])
}

model Supplier {
  id             String            @id @default(cuid())
  code           String            @unique
  name           String
  partyType      PartyType
  phone          String?
  email          String?
  taxId          String?
  notes          String?
  metadata       Json              @default("{}")
  supplierTypeId String?
  supplierType   SupplierType?     @relation(fields: [supplierTypeId], references: [id], onDelete: SetNull)
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  bookings       ServiceBooking[]
  addresses      SupplierAddress[]
  phones         SupplierPhone[]

  @@index([name])
  @@index([supplierTypeId])
}

model SupplierAddress {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  label      String?
  address    String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId, isPrimary])
}

model SupplierPhone {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  label      String?
  phone      String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([supplierId, phone])
  @@index([supplierId, isPrimary])
}

model SupplierType {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String     @unique
  description String?
  metadata    Json       @default("{}")
  active      Boolean    @default(true)
  suppliers   Supplier[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model TourGuide {
  id                   String                       @id @default(cuid())
  fullName             String
  gender               String
  dateOfBirth          DateTime?
  identityNumber       String                       @unique
  permanentAddress     String?
  taxCode              String?
  phone                String
  accountName          String?
  bankAccountNumber    String?
  bankName             String?
  itineraryDays        QuickItineraryDay[]
  itineraryAssignments QuickItineraryDayTourGuide[]
  tourPrograms         QuickTourProgramGuide[]
  contracts            TourGuideContract[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@index([fullName])
  @@index([phone])
}

model Channel {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  metadata    Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, name])
}

model Country {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  metadata    Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, name])
}

model LeadSource {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  metadata    Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, name])
}

model TravelType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  metadata    Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, name])
}

model LeadStatus {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  metadata    Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, name])
}

model LeadQuality {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  metadata    Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, name])
}

model PreferredContact {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  metadata    Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, name])
}

model HotelCategory {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  metadata    Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, name])
}

model LeadBookingStatus {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  metadata    Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, name])
}

model PaymentStatus {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  metadata    Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, name])
}

model FollowUpStatus {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  metadata    Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, name])
}

model LostReason {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  metadata    Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, name])
}

model MealPreference {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  metadata    Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, name])
}

model Lead {
  id                String            @id @default(cuid())
  leadId            String            @unique
  dateReceived      DateTime
  leadSource        String?
  channel           String?
  campaign          String?
  customerName      String
  country           String?
  phone             String?
  whatsapp          String?
  preferredContact  String?
  email             String?
  travelDate        DateTime?
  numberOfPax       Int?
  adults            Int?
  children          Int?
  destination       String?
  duration          String?
  travelType        String?
  hotel             String?
  category          String?
  meal              String?
  preference        String?
  specialRequest    String?
  budgetUsd         Decimal?          @db.Decimal(14, 2)
  leadStatus        String?
  dateConfirmation  DateTime?
  leadQuality       String?
  assignedToId      String?
  assignedTo        User?             @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastContact       DateTime?
  nextFollowUp      DateTime?
  quotationNo       String?
  quotationValueUsd Decimal?          @db.Decimal(14, 2)
  followUpStatus    String?
  bookingStatus     String?
  bookingValueUsd   Decimal?          @db.Decimal(14, 2)
  paymentStatus     String?
  lostReason        String?
  remarks           String?
  createdByType     String
  createdById       String
  createdByName     String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  quickItinerary    QuickItinerary?
  invoice           LeadInvoice?
  estimate          InvoiceEstimate?
  confirmation      LeadConfirmation?

  @@index([dateReceived])
  @@index([assignedToId, nextFollowUp])
  @@index([leadStatus])
  @@index([dateConfirmation])
}

model LeadConfirmation {
  id                  String                @id @default(cuid())
  leadId              String?               @unique
  lead                Lead?                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  b2bLeadId           String?               @unique
  b2bLead             B2BLead?              @relation(fields: [b2bLeadId], references: [id], onDelete: Cascade)
  numberOfGuests      String?
  numberOfRooms       String?
  nationality         String?
  guide               String?
  essentialTravelInfo String?
  notes               String?
  createdByType       String
  createdById         String
  createdByName       String
  days                LeadConfirmationDay[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([createdById, updatedAt])
}

model LeadConfirmationDay {
  id               String           @id @default(cuid())
  confirmationId   String
  confirmation     LeadConfirmation @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  dayNumber        Int
  date             DateTime
  itinerary        String?
  meals            String?
  transferGuide    String?
  hotelInformation String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([confirmationId, dayNumber])
  @@index([confirmationId, dayNumber])
}

model B2BLead {
  id                String            @id @default(cuid())
  leadId            String            @unique
  dateReceived      DateTime
  leadSource        String?           @default("B2B")
  channel           String?
  campaign          String?
  customerName      String
  country           String?
  phone             String?
  whatsapp          String?
  preferredContact  String?
  email             String?
  travelDate        DateTime?
  numberOfPax       Int?
  adults            Int?
  children          Int?
  destination       String?
  duration          String?
  travelType        String?
  hotel             String?
  category          String?
  meal              String?
  preference        String?
  specialRequest    String?
  budgetUsd         Decimal?          @db.Decimal(14, 2)
  leadStatus        String?
  dateConfirmation  DateTime?
  leadQuality       String?
  assignedToId      String?
  assignedTo        User?             @relation("B2BLeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastContact       DateTime?
  nextFollowUp      DateTime?
  quotationNo       String?
  quotationValueUsd Decimal?          @db.Decimal(14, 2)
  followUpStatus    String?
  bookingStatus     String?
  bookingValueUsd   Decimal?          @db.Decimal(14, 2)
  paymentStatus     String?
  lostReason        String?
  remarks           String?
  createdByType     String
  createdById       String
  createdByName     String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  quickItinerary    QuickItinerary?
  invoice           LeadInvoice?
  estimate          InvoiceEstimate?
  confirmation      LeadConfirmation?

  @@index([dateReceived])
  @@index([assignedToId, nextFollowUp])
  @@index([leadStatus])
  @@index([dateConfirmation])
}

model LeadFieldConfig {
  id              String                    @id @default(cuid())
  fieldKey        String                    @unique
  label           String
  displayOrder    Int
  groupCode       String                    @default("BASIC")
  visibleTo       Json                      @default("[\"ADMIN\",\"USER\"]")
  editableBy      Json                      @default("[\"ADMIN\",\"USER\"]")
  active          Boolean                   @default(true)
  rolePermissions LeadFieldRolePermission[]
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([active, displayOrder])
}

model LeadFieldRolePermission {
  fieldConfigId String
  fieldConfig   LeadFieldConfig @relation(fields: [fieldConfigId], references: [id], onDelete: Cascade)
  systemRoleId  String
  systemRole    SystemRole      @relation(fields: [systemRoleId], references: [id], onDelete: Cascade)
  canRead       Boolean         @default(false)
  canWrite      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@id([fieldConfigId, systemRoleId])
  @@index([systemRoleId])
}

model DocumentTemplate {
  id                    String               @id @default(cuid())
  code                  String               @unique
  name                  String
  type                  DocumentTemplateType
  description           String?
  content               String
  imageFolderId         String?
  imageStoredName       String?
  imageOriginalName     String?
  imageMimeType         String?
  imageAlt              String?
  metadata              Json                 @default("{}")
  isDefault             Boolean              @default(false)
  active                Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  itineraryHeaders      WorkCaseItinerary[]  @relation("ItineraryHeaderTemplate")
  itineraryFooters      WorkCaseItinerary[]  @relation("ItineraryFooterTemplate")
  quickItineraryHeaders QuickItinerary[]     @relation("QuickItineraryHeaderTemplate")
  quickItineraryFooters QuickItinerary[]     @relation("QuickItineraryFooterTemplate")

  @@index([type, active])
  @@index([type, isDefault])
}

model TemplateBuilderDocument {
  id                 String                   @id @default(cuid())
  code               String                   @unique
  name               String
  description        String?
  documentType       String
  active             Boolean                  @default(true)
  isDefault          Boolean                  @default(false)
  publishedVersionId String?                  @unique
  publishedVersion   TemplateBuilderVersion?  @relation("PublishedBuilderVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions           TemplateBuilderVersion[] @relation("BuilderVersions")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([documentType, active])
}

model TemplateBuilderVersion {
  id              String                    @id @default(cuid())
  documentId      String
